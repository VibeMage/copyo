      }
    },
    "Click the shortcut to customize it. The default is ⇧⌘V.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le raccourci pour le modifier. Par défaut : ⇧⌘V."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击快捷键可以自定义，默认 ⇧⌘V。"
          }
        }
      }
    },
