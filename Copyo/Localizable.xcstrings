    "Sync clipboard history": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser l’historique"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步历史记录"
          }
        }
      }
    },
    "Sync through your iCloud account. Every Mac signed in to the same Apple Account sees the same history, and deleting an entry removes it everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation via votre compte iCloud. Chaque Mac connecté au même compte Apple voit le même historique, et la suppression d’un élément s’applique partout."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过你的 iCloud 账号同步。登录同一 Apple 账户的每台 Mac 看到同一份历史，删除某个条目也会在所有设备上生效。"
          }
        }
      }
    },
    "Text": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本"
          }
        }
      }
    },
    "The combination must include at least one of ⌘, ⌥ or ⌃. Press Esc to cancel.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La combinaison doit contenir au moins ⌘, ⌥ ou ⌃. Appuyez sur Esc pour annuler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组合键需要至少包含 ⌘、⌥ 或 ⌃ 其中之一，按 Esc 取消。"
          }
        }
      }
    },
    "The parent directory of the custom sync folder does not exist. Please check the path.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le répertoire parent du dossier de synchronisation personnalisé n’existe pas. Vérifiez le chemin d’accès."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
