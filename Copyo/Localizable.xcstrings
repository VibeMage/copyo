    },
    "Changing the sync method takes effect after you restart Copyo.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement de méthode de synchronisation prend effet après le redémarrage de Copyo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改同步方式后需要重启 Copyo 才会生效。"
          }
        }
      }
    },
