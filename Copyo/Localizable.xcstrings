            "state": "translated",
            "value": "Cette copie de Copyo n’est pas signée pour la synchronisation iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份 Copyo 的签名不包含 iCloud 同步授权。"
          }
        }
      }
    },
    "This deletes every clipboard entry that isn’t pinned to a Pinboard. This action cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les éléments du presse-papiers non épinglés à un Pinboard seront supprimés. Cette action est irréversible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除所有未固定到 Pinboard 的剪贴板记录，此操作不可撤销。"
          }
        }
      }
    },
