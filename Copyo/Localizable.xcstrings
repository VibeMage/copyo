        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览选中内容（搜索框为空时）"
          }
        }
      }
    },
    "Push notifications are unavailable on this Mac, so changes made on your other devices only arrive when Copyo starts.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications push ne sont pas disponibles sur ce Mac : les modifications faites sur vos autres appareils n’arrivent donc qu’au lancement de Copyo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 无法接收推送通知，其他设备上的改动只有在 Copyo 启动时才会同步下来。"
          }
        }
      }
    },
    "Quit Copyo": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter Copyo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Copyo"
          }
        }
      }
    },
    "Quit Copyo from the menu bar icon and open it again — it finishes clearing the database file on the next launch.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez Copyo depuis l’icône de la barre des menus puis relancez-le — il terminera l’effacement du fichier de base de données au prochain démarrage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从菜单栏图标退出 Copyo 再重新打开——它会在下次启动时把数据库文件清除干净。"
          }
        }
      }
    },
    "Quit Copyo from the menu bar icon and open it again. Your new sync setting is already saved.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez Copyo depuis l’icône de la barre des menus puis relancez-le. Votre nouvelle méthode de synchronisation est déjà enregistrée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从菜单栏图标退出 Copyo 再重新打开。你新选的同步方式已经保存好了。"
          }
        }
      }
    },
