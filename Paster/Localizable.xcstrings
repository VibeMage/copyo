    "Signed in to iCloud": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录 iCloud"
          }
        }
      }
    },
    "Snapshot sync through a folder every device can reach. Deletions are not propagated: an entry you delete on one Mac stays on the others.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过一个所有设备都能读写的文件夹做快照同步。删除不会传播：在一台 Mac 上删掉的条目，在其他 Mac 上依然保留。"
          }
        }
      }
    },
    "Space": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空格"
          }
        }
      }
    },
    "Sync": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步"
          }
        }
      }
    },
    "Sync Folder": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步文件夹"
          }
        }
      }
    },
    "Sync Method": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步方式"
          }
        }
      }
    },
    "Sync Now": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即同步"
          }
        }
      }
    },
    "Sync clipboard history": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步历史记录"
          }
        }
      }
    },
    "Sync through your iCloud account. Every Mac signed in to the same Apple Account sees the same history, and deleting an entry removes it everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过你的 iCloud 账号同步。登录同一 Apple 账户的每台 Mac 看到同一份历史，删除某个条目也会在所有设备上生效。"
          }
        }
      }
    },
    "Text": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本"
          }
        }
      }
    },
    "The combination must include at least one of ⌘, ⌥ or ⌃. Press Esc to cancel.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组合键需要至少包含 ⌘、⌥ 或 ⌃ 其中之一，按 Esc 取消。"
          }
        }
      }
    },
    "The parent directory of the custom sync folder does not exist. Please check the path.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义同步文件夹的上级目录不存在，请检查路径。"
          }
        }
      }
    },
    "This copy of Paster is not signed for iCloud sync.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份 Paster 的签名不包含 iCloud 同步授权。"
          }
        }
      }
    },
    "This deletes every clipboard entry that isn’t pinned to a Pinboard. This action cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除所有未固定到 Pinboard 的剪贴板记录，此操作不可撤销。"
          }
        }
      }
    },
    "Try It Now": {
      "extractionState": "manual",
      "localizations": {
