            "value": "预览选中内容（搜索框为空时）"
          }
        }
      }
    },
    "Push notifications are unavailable on this Mac, so changes made on your other devices only arrive when Paster starts.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 无法接收推送通知，其他设备上的改动只有在 Paster 启动时才会同步下来。"
          }
        }
      }
    },
