    "Set it to Allow and Copyo reads the clipboard the moment it opens, with no prompt. This is an iOS privacy setting, so it can only be changed in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set it to Allow and Copyo reads the clipboard the moment it opens, with no prompt. This is an iOS privacy setting, so it can only be changed in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez-le sur « Autoriser » et Copyo lit le presse-papiers dès son ouverture, sans aucune demande. C’est un réglage de confidentialité iOS : il ne peut être modifié que dans les Réglages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为「允许」后，打开 Copyo 时自动读取剪贴板，不再弹窗。这是 iOS 的隐私设置，只能在系统「设置」里更改。"
          }
        }
      }
    },
