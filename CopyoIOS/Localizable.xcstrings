            "state": "translated",
            "value": "打开 Copyo 时"
          }
        }
      }
    },
    "With this off, Copyo won't read the clipboard when it opens — use the banner at the top of History to paste and save by hand.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With this off, Copyo won't read the clipboard when it opens — use the banner at the top of History to paste and save by hand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ce réglage est désactivé, Copyo ne lit pas le presse-papiers à son ouverture : utilisez la bannière en haut de l’historique pour coller et enregistrer à la main."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，回到 Copyo 不会自动读取剪贴板；用历史顶部的横幅手动粘贴保存。"
          }
        }
      }
    },
    "You can change both later in Settings.": {
      "extractionState": "manual",
