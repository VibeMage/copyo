    "Already saved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already saved"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà enregistré"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存过"
          }
        }
      }
    },
    "An open-source clipboard manager. Mac, iPhone and iPad share one history through your own iCloud account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An open-source clipboard manager. Mac, iPhone and iPad share one history through your own iCloud account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gestionnaire de presse-papiers open source. Mac, iPhone et iPad partagent un même historique via votre propre compte iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源的剪贴板管理器。Mac、iPhone 与 iPad 通过你自己的 iCloud 账户共用同一份历史。"
          }
        }
      }
    },
    "Anything you copy on your Mac needs no action at all — it arrives here through iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything you copy on your Mac needs no action at all — it arrives here through iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous copiez sur votre Mac arrive ici via iCloud, sans aucune action de votre part."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 上复制的内容不需要任何操作，会自动通过 iCloud 出现在历史里。"
          }
        }
      }
    },
    "Anything you copy on your Mac shows up here through iCloud. To keep something from this iPhone, use Share or Quick Save.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything you copy on your Mac shows up here through iCloud. To keep something from this iPhone, use Share or Quick Save."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous copiez sur votre Mac apparaît ici via iCloud. Pour conserver quelque chose depuis cet iPhone, utilisez « Partager » ou « Enregistrement rapide »."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上复制过的内容，会通过 iCloud 出现在这里。手机上想留住的，用「分享」或「一键保存」存进来。"
          }
        }
      }
    },
