    "Every time you open or come back to Copyo it reads the current clipboard and saves it to your history. “Paste from Other Apps” has to be set to Allow.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every time you open or come back to Copyo it reads the current clipboard and saves it to your history. “Paste from Other Apps” has to be set to Allow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fois que vous ouvrez Copyo ou y revenez, il lit le presse-papiers et l’enregistre dans votre historique. « Coller depuis d’autres apps » doit être réglé sur « Autoriser »."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次打开或回到 Copyo，自动读取当前剪贴板并存入历史。需要把「从其他 App 粘贴」设为允许。"
          }
        }
      }
    },
    "Everything you copy on your Mac arrives here through iCloud. Search anytime, tap to copy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you copy on your Mac arrives here through iCloud. Search anytime, tap to copy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous copiez sur votre Mac arrive ici via iCloud. Recherchez à tout moment, touchez pour copier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上复制过的一切，会通过 iCloud 出现在这里。随时搜，轻点即复制。"
          }
        }
      }
    },
