    "Sign in to the same Apple Account on your Mac and iPhone. Your clips travel through iCloud only, never through a third-party server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to the same Apple Account on your Mac and iPhone. Your clips travel through iCloud only, never through a third-party server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous au même compte Apple sur votre Mac et votre iPhone. Vos éléments passent uniquement par iCloud, jamais par un serveur tiers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 与 iPhone 登录同一 Apple 账户即可。内容只经过 iCloud，不经过任何第三方服务器。"
          }
        }
      }
    },
