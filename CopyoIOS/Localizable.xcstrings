    "Add the “Save Clipboard” Shortcut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the “Save Clipboard” Shortcut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter le raccourci « Enregistrer le presse-papiers »"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加「保存剪贴板」快捷指令"
          }
        }
      }
    },
    "Add “Save Clipboard”": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add “Save Clipboard”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter « Enregistrer le presse-papiers »"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入「保存剪贴板」"
          }
        }
      }
    },
    "After copying, press the Action Button, double-tap the back of your iPhone, or tap the Control Center button. Copyo opens and shows “Saved”.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After copying, press the Action Button, double-tap the back of your iPhone, or tap the Control Center button. Copyo opens and shows “Saved”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir copié, appuyez sur le bouton Action, touchez deux fois le dos de votre iPhone ou touchez le bouton du Centre de contrôle. Copyo s’ouvre et affiche « Enregistré »."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制后按操作按钮、敲两下手机背面，或点控制中心按钮。Copyo 会打开并提示「已保存」。"
          }
        }
      }
    },
    "All": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All"
          }
        },
        "fr": {
