    "iOS won't let apps read the clipboard in the background, so Copyo only saves at these three moments.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS won't let apps read the clipboard in the background, so Copyo only saves at these three moments."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n’autorise pas les apps à lire le presse-papiers en arrière-plan : Copyo n’enregistre donc qu’à ces trois moments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不允许 App 在后台读剪贴板，所以 Copyo 只在这三种时刻保存内容。"
          }
        }
      }
    },
